# -----------------------------------------------------------------------------
# NorAI Technologies — Environment Configuration Template
# Copy this file to `.env` or `.env.local` for local development.
# WARNING: Never commit real API keys or passwords to version control.
# -----------------------------------------------------------------------------

# Public Client Variables (Accessible in browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ID=

# Server-Side Model Inference Credentials (Server-only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-lite

# Contact Form & Dispatch Configuration (Server-only)
EMAIL_USER=your_smtp_user@gmail.com
EMAIL_PASS=your_smtp_app_password_here

# Contact Routing Addresses
CONTACT_SALES_EMAIL=sales@noraitech.com
CONTACT_CAREERS_EMAIL=careers@noraitech.com
CONTACT_PRESS_EMAIL=press@noraitech.com
