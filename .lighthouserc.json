{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3000",
      "startServerReadyPattern": "Ready in|ready - started server",
      "startServerReadyTimeout": 180000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/products",
        "http://localhost:3000/services",
        "http://localhost:3000/mission",
        "http://localhost:3000/team",
        "http://localhost:3000/careers",
        "http://localhost:3000/contact",
        "http://localhost:3000/blog",
        "http://localhost:3000/docs",
        "http://localhost:3000/products/resume-shortlister",
        "http://localhost:3000/products/course-note-taker",
        "http://localhost:3000/products/chat-digest",
        "http://localhost:3000/products/smart-dainik-news",
        "http://localhost:3000/blog/ai-agent-orchestration-architecture",
        "http://localhost:3000/blog/rag-vector-search-best-practices",
        "http://localhost:3000/blog/mcp-protocol-developer-tooling",
        "http://localhost:3000/blog/automated-resume-screening-patterns",
        "http://localhost:3000/blog/operational-discipline-devops-reliability",
        "http://localhost:3000/blog/deploying-open-weight-llms-vllm-awq",
        "http://localhost:3000/blog/multimodal-audio-video-synthesis-latex",
        "http://localhost:3000/blog/zero-hallucination-enterprise-guardrails",
        "http://localhost:3000/blog/vernacular-nlp-hindi-english-gazette-parsing",
        "http://localhost:3000/privacy-policy",
        "http://localhost:3000/terms-of-service",
        "http://localhost:3000/cookie-policy"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.6 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1.0 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1500 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 5000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 1000 }],
        "interactive": ["warn", { "maxNumericValue": 6500 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
